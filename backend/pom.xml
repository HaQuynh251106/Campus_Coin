<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.4.3</version>
		<relativePath/>
	</parent>
	<groupId>com.campuscoin</groupId>
	<artifactId>campus-coin-backend</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<name>campus-coin-backend</name>
	<description>Campus Coin - student personal finance and expense tracking REST API</description>

	<properties>
		<java.version>21</java.version>
		<springdoc.version>2.8.5</springdoc.version>
		<jjwt.version>0.12.6</jjwt.version>
		<google.genai.version>1.73.0</google.genai.version>
		<!--
		  Overrides the version Spring Boot's dependency management would pick (1.20.x).
		  Testcontainers 1.20 negotiates an API version below 1.40, which Docker Engine 29
		  rejects with 400 Bad Request, so the container would never start. 1.21 uses a
		  docker-java that negotiates a supported version.
		-->
		<testcontainers.version>1.21.3</testcontainers.version>
	</properties>

	<dependencies>
		<!-- Spring Boot Starters -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!--
			Outbound email, used for one thing: delivering the UC-03 password reset link to the
			account's mailbox.

			The dependency is present whether or not a mail server is configured. Spring Boot
			creates a JavaMailSender only when spring.mail.host is set, so a deployment without an
			SMTP host starts normally and PasswordResetConfig installs the no-op notifier - the
			same shape AiConfig uses for GEMINI_API_KEY. Credentials are read from the
			environment (MAIL_USERNAME / MAIL_PASSWORD) and are never written to application.yml,
			the database, a JWT or the frontend.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>

		<!-- Swagger / OpenAPI Documentation -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>

		<!--
			Google Gen AI Java SDK - the AI provider for UC-08 (category suggestion) and UC-17
			(monthly narrative). It is a hard dependency of the build but not of the running
			application: AiConfig installs NoopAiSuggestionPort when no credential is present,
			so a deployment without GEMINI_API_KEY starts normally and both use cases run on
			their deterministic, database-backed paths instead.

			The credential is read from the environment by AiProperties and is never written to
			application.yml, the database, a JWT or the frontend.
		-->
		<dependency>
			<groupId>com.google.genai</groupId>
			<artifactId>google-genai</artifactId>
			<version>${google.genai.version}</version>
		</dependency>

		<!-- Database - MySQL is the single source of truth for the schema -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- JSON Web Token (HS256) -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jjwt.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>

		<!-- Developer Tools -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Testing -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
		  Test scope only, and the version is Spring Boot's managed one.

		  Without a real HTTP client on the classpath, TestRestTemplate falls back to the JDK's
		  HttpURLConnection, which rejects the PATCH method outright with
		  "Invalid HTTP method: PATCH". Module 2 uses PATCH for both profile endpoints - the
		  method is part of the documented contract, not a detail of the tests - so the harness
		  has to be able to speak it. Adding this makes RestTemplate auto-configure a client that
		  can, rather than contorting the API to fit a testing limitation.
		-->
		<dependency>
			<groupId>org.apache.httpcomponents.client5</groupId>
			<artifactId>httpclient5</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Integration tests run against a real MySQL 8 with the project's own SQL loaded -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>mysql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!--
					  Surefire only picks up *Test / *Tests by default. The API tests are
					  named *IT because they exercise the real HTTP stack against a real
					  MySQL, so they have to be included explicitly or `mvn test` would
					  silently run nothing but the context test.
					-->
					<includes>
						<include>**/*Test.java</include>
						<include>**/*Tests.java</include>
						<include>**/*IT.java</include>
					</includes>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!--
		  mvn test -Pstandalone
		  Skips the Testcontainers-based integration suites so the unit tests can run
		  on a machine without a Docker daemon.
		-->
		<profile>
			<id>standalone</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<includes>
								<include>**/*Test.java</include>
								<include>**/*Tests.java</include>
							</includes>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
