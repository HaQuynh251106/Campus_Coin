# Root Git Ignore for Campus Coin

# OS
.DS_Store
Thumbs.db

# IDE & Editors
.idea/
*.iml
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# Backend (Java / Maven)
backend/target/
backend/*.jar
backend/*.war
backend/.mvn/wrapper/maven-wrapper.jar

# Frontend (Node / Angular)
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/.sass-cache/
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# Database & Logs
*.log
pgdata/

# Environment secrets — real credentials stay local, .env.example is committed.
# `.env*` covers .env, .env.local, .env.<profile>, and every backup spelling
# (.env.local.bak, .env.bak, .env.old …) so a hand-made backup cannot leak.
.env*
!.env.example

# Local AI-tooling artifacts (never part of the product)
.claude/settings.local.json
.playwright-mcp/

# Docker local generated files
docker-compose.override.yml

# IDE & build artifacts not already covered above
.vscode/settings.json
frontend/.vite/
backend/bin/
backend/obj/
*.zip
