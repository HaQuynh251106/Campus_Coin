# ============================================================================
#  CAMPUS COIN — environment configuration template
#
#  Usage: copy this file to .env and fill in the real passwords.
#
#      cp .env.example .env
#
#  .env is gitignored — do NOT commit real passwords to git.
#  This .env.example file IS committed, so it holds sample values only.
# ============================================================================

# ---------------------------------------------------------------------------
#  Docker Compose — MySQL 8 container
# ---------------------------------------------------------------------------

# Password for the MySQL administrative account (root). Required.
MYSQL_ROOT_PASSWORD=

# The project database.
MYSQL_DATABASE=campuscoin

# Account used by the API. Do not use root in the application's connection.
MYSQL_USER=campuscoin_app

# Password for the API account. Required.
MYSQL_PASSWORD=

# ---------------------------------------------------------------------------
#  Spring Boot backend
#
#  These are read by the application process, not by Docker Compose. Export them
#  before starting the backend; see README.md section 3.7.
# ---------------------------------------------------------------------------

# HS256 signing key for access tokens. Required — there is no default, so the
# application will not start without it. Must be at least 32 bytes.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# AES-256-GCM key for application-level field encryption of the free-text columns
# (transaction and recurring-rule descriptions, bookmark notes). Required — there is
# no default, so the application will not start without it. Must be the Base64
# encoding of exactly 32 random bytes.
#
# Generate one with:  openssl rand -base64 32
#
# This is a symmetric secret, not a private key. It stays in the environment only:
# never committed to git, never written into MySQL, never put in a JWT.
#
# WARNING — data encrypted with one key cannot be read by a build configured with a
# different one. Losing this value makes every encrypted description and note
# unreadable; there is no recovery path that does not involve the key. Back it up
# wherever the other production secrets are held.
#
# Not used for amounts: MySQL cannot decrypt, so an encrypted amount could not be
# summed by any report. See OB-013 in docs/OVERNIGHT_BLOCKERS.md.
CAMPUSCOIN_ENCRYPTION_KEY=

# The campuscoin_app password. Usually the same value as MYSQL_PASSWORD above.
DB_PASSWORD=

# Connection settings. All optional; the defaults match the Docker stack.
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=campuscoin
# DB_USER=campuscoin_app

# Origins allowed to call the API from a browser. Never a wildcard.
# CORS_ALLOWED_ORIGINS=http://localhost:4200

# Base URL of the Angular password-reset screen, used to build the reset link.
# RESET_LINK_BASE_URL=http://localhost:4200/reset-password

# ---------------------------------------------------------------------------
#  Password-reset email (UC-03)
#
#  The reset link is sent by email. Configuration is optional: with no MAIL_HOST
#  the backend still starts and the reset request still succeeds, but no message
#  is delivered. In the dev profile the link is instead written to a file under
#  backend/target/ so the flow can be demonstrated without a mail server
#  (RESET_SINK_ENABLED=false turns that off and enables real sending).
# ---------------------------------------------------------------------------

# The outgoing mail server that delivers the reset link. Optional; empty means
# no email is sent. Example values are for a transactional provider such as
# SendGrid, Mailgun or Amazon SES.
# MAIL_HOST=smtp.example.com

# Submission port. 587 pairs with STARTTLS (the default, below). For implicit
# TLS use 465 and set MAIL_SSL=true as well.
# MAIL_PORT=587

# SMTP account. Optional: leave both blank for a local catcher or an IP-trusted
# relay that needs no authentication.
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=

# The sender the reset email comes from. It must be an address the SMTP account
# is allowed to send as, or the provider rejects the message as spoofing. With
# this blank no email is sent even if MAIL_HOST is set — an email with no usable
# From cannot be delivered.
# MAIL_FROM_ADDRESS=no-reply@example.com
# MAIL_FROM_NAME=Campus Coin

# Leave MAIL_STARTTLS at its default (true) for any real provider: the message
# carries a one-time reset token, so an unencrypted hop would expose account
# access. Set it false only for a local catcher with no TLS (MailHog, Mailpit).
# MAIL_STARTTLS=false
# MAIL_SSL=true

# ---------------------------------------------------------------------------
#  AI provider (UC-08 category suggestion, UC-17 monthly narrative)
#
#  The provider is Google's Gemini API. Optional. With no GEMINI_API_KEY the
#  backend still starts and installs the no-op provider: UC-08 answers from the
#  student's own learned category_rules, and UC-17 keeps the rule-based summary
#  the database wrote. Nothing is faked — insights.generated_by records
#  RULE_BASED rather than AI.
#
#  The provider is never given database access. Only context this backend has
#  already read, filtered to the signed-in student and reduced to aggregates is
#  ever sent; the AI key never reaches Angular, MySQL or a JWT.
# ---------------------------------------------------------------------------

# The provider credential. Read from the environment only — never written into
# application.yml, never committed, never stored in the database.
# GEMINI_API_KEY=

# The model to call. Changing it changes where student data is sent, so it is
# deployment configuration rather than an administrator-tunable setting.
# AI_MODEL=gemini-3.5-flash

# Response cap and one call's latency bound. A timeout is treated as
# "no suggestion" and the request still succeeds.
# AI_MAX_TOKENS=1024
# AI_TIMEOUT_SECONDS=20

# Left unset in a real deployment so the SDK's own endpoint applies. Set it only
# to point at a compatible gateway or a local stub.
# AI_BASE_URL=
